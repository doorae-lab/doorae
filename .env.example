OPENAI_API_KEY=your-api-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1  # Optional: 커스텀 엔드포인트 (Azure OpenAI, 프록시 등)

# Main LLM (회의 에이전트 응답 생성)
LLM_MAIN_MODEL=gpt-4o-mini
LLM_MAIN_TEMPERATURE=0.7

# Task LLM (작은 작업: 멘션 추출, 종료 감지, 안건 분석)
LLM_TASK_MODEL=gpt-4o-mini
LLM_TASK_TEMPERATURE=0.0

# LangGraph 설정
RECURSION_LIMIT=100  # LangGraph 재귀 깊이 제한 (기본값: 100)
MAX_TURNS=30  # 회의 최대 턴 수 (무한루프 방지, 기본값: 30)

AGENT_PROFILES_PATH=config/agent_profiles.yaml

# LangSmith Tracing (Optional)
# LANGCHAIN_TRACING_V2=true  # 추적 활성화 (기본값: false)
# LANGCHAIN_API_KEY=your-langsmith-api-key
# LANGCHAIN_PROJECT=thetable  # 프로젝트 이름 (기본값: thetable)
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com  # 커스텀 엔드포인트 (선택)
