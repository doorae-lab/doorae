# ============================================
# LLM 설정
# ============================================
#
# 추천 모델 (OpenRouter 권장):
#   - MAIN MODEL: qwen/qwen3.5-flash-02-23 (가성비 우수, 빠른 응답)
#   - TASK MODEL: google/gemini-2.5-flash (빠른 추출 작업 처리)
#
# OpenRouter 권장 이유:
#   1. 가성비: OpenAI 직접 사용 대비 비용 효율적
#   2. 속도: 아젠다/이슈 추출 과정에서 OpenAI 모델 대비 시간 단축 (LangSmith trace 기반)
#
# OpenAI 직접 사용도 가능:
#   - MAIN MODEL: gpt-5-mini
#   - TASK MODEL: gpt-5-nano

# === 공통 설정 (Fallback) ===
# Main/Task 모두 같은 제공자 사용 시 이것만 설정하면 됨
OPENAI_API_KEY=your-api-key-here

# OpenRouter 사용 시 (권장)
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# OpenAI 직접 사용 시
# OPENAI_BASE_URL=https://api.openai.com/v1

# === Main LLM 설정 (회의 에이전트 응답 생성) ===
# OpenRouter 추천 모델
LLM_MAIN_MODEL=qwen/qwen3.5-flash-02-23

# OpenAI 직접 사용 시
# LLM_MAIN_MODEL=gpt-5-mini

LLM_MAIN_TEMPERATURE=0.7
LLM_MAIN_MAX_TOKENS=4096

# Main LLM 전용 제공자 사용 시 (선택적)
# LLM_MAIN_API_KEY=sk-main-specific-key
# LLM_MAIN_BASE_URL=https://openrouter.ai/api/v1

# === Task LLM 설정 (멘션 추출, 종료 감지, 안건 분석) ===
# OpenRouter 추천 모델
LLM_TASK_MODEL=google/gemini-2.5-flash

# OpenAI 직접 사용 시
# LLM_TASK_MODEL=gpt-5-nano

LLM_TASK_TEMPERATURE=0.0
LLM_TASK_MAX_TOKENS=256
MENTION_EXTRACTION_MAX_TOKENS=64  # Human 입력 fallback 멘션 추출 상한

# Task LLM 전용 제공자 사용 시 (선택적)
# 예시 1: Azure OpenAI
# LLM_TASK_API_KEY=azure-task-key
# LLM_TASK_BASE_URL=https://your-resource.openai.azure.com/openai/deployments/gpt-35-turbo
# LLM_TASK_MODEL=gpt-35-turbo

# 예시 2: 로컬 Ollama
# LLM_TASK_BASE_URL=http://localhost:11434/v1
# LLM_TASK_MODEL=llama3

# === 공통 연결 설정 ===
LLM_TIMEOUT=60.0
LLM_MAX_RETRIES=3

# LangGraph 설정
RECURSION_LIMIT=1000  # LangGraph 재귀 깊이 제한 (기본값: 1000)
MAX_TURNS=1000  # 회의 최대 턴 수 (무한루프 방지, 기본값: 1000)

# 대화 요약 설정
MAX_MESSAGES_BEFORE_SUMMARY=8  # 이 개수 초과 시 요약 생성 (기본값: 8)
KEEP_RECENT_MESSAGES=3  # 요약 후 유지할 최근 메시지 개수 (기본값: 3)
SUMMARY_MAX_TOKENS=3000  # 요약 최대 토큰 수 (기본값: 3000)

AGENT_PROFILES_PATH=config/agent_profiles.yaml

# MCP Tools 설정
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_your_actual_token_here

# LangSmith Tracing (Optional)
# LANGCHAIN_TRACING_V2=true  # 추적 활성화 (기본값: false)
# LANGCHAIN_API_KEY=your-langsmith-api-key
# LANGCHAIN_PROJECT=doorae  # 프로젝트 이름 (기본값: doorae)
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com  # 커스텀 엔드포인트 (선택)
